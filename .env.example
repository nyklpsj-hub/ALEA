# ---------------------------------------------------------------------------
# Alea backend configuration. Copy to `backend/.env` and fill in real values.
# Nothing here is required at build time; the app validates on startup.
# ---------------------------------------------------------------------------

# --- app ---
APP_ENV=local
DEBUG=false
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
# Set to true only on a machine you control: it disables redaction of user text in logs.
LOG_USER_CONTENT=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- database ---
# Port 55432 matches the docker-compose mapping and scripts/local_postgres.py,
# so the same values work with or without Docker.
DATABASE_URL=postgresql+asyncpg://alea:alea@127.0.0.1:55432/alea
CHECKPOINT_DATABASE_URL=postgresql://alea:alea@127.0.0.1:55432/alea

# --- chat model (any OpenAI-compatible endpoint) ---
# OpenAI:      https://api.openai.com/v1        gpt-4o-mini
# DeepSeek:    https://api.deepseek.com/v1      deepseek-chat
# Qwen:        https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
# Moonshot:    https://api.moonshot.cn/v1       moonshot-v1-32k
# Ollama:      http://127.0.0.1:11434/v1        qwen2.5:14b
#
# LLM_MAX_TOKENS is forwarded to the provider as `max_completion_tokens`
# (the canonical OpenAI parameter name that LangChain uses).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.5
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# --- embeddings ---
# provider=openai -> uses EMBEDDING_BASE_URL/EMBEDDING_API_KEY (falls back to the LLM ones)
# provider=local  -> offline model via `pip install '.[local-embeddings]'` (needs EMBEDDING_DIM=512)
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- retrieval ---
RAG_TOP_K=5
RAG_MIN_SCORE=0.15
MEMORY_TOP_K=6
MEMORY_MIN_SCORE=0.2
MEMORY_DEDUP_SIMILARITY=0.9

# --- agent behaviour ---
AGENT_SOFT_TURN_LIMIT=8
AGENT_HARD_TURN_LIMIT=16
AGENT_SUFFICIENCY_THRESHOLD=0.62
AGENT_MAX_TOOL_ROUNDS=3
